.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
dist/
build/
*.egg-info/
configs/local.json

# Keep binary image/reference media local unless explicitly needed.
*.png
*.jpg
*.jpeg
*.gif
*.webp

# Local samples may contain private gameplay screenshots.
samples/**/screenshots/*
!samples/**/screenshots/.gitkeep

# dhxy2_classic_pc curated samples are part of the template regression suite.
!samples/dhxy2_classic_pc/screenshots/
!samples/dhxy2_classic_pc/screenshots/*

# Additional user-provided dhxy2_classic_pc screenshots kept for future templates.
!samples/dhxy2_classic_pc/candidates/
!samples/dhxy2_classic_pc/candidates/*
